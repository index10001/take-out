<view class="card data-v-d5c0dd20">
  <view class="title data-v-d5c0dd20"> 送达时间：预计60分钟后送达 </view>
<view class="title data-v-d5c0dd20"> 配送地点 </view><view class="content data-v-d5c0dd20" bindtap="{{c}}"><text wx:if="{{a}}" class="data-v-d5c0dd20">🔸 {{b}}</text><text wx:else class="data-v-d5c0dd20">+ 选择配送地点</text></view><view wx:for="{{d}}" wx:for-item="address" wx:key="c" class="{{['addresses', 'data-v-d5c0dd20', e && 'open']}}"><text class="address data-v-d5c0dd20" bindtap="{{address.b}}">{{address.a}}</text></view></view><view class="card data-v-d5c0dd20"><view class="title data-v-d5c0dd20"> 配送时间 </view><view class="content data-v-d5c0dd20"><picker wx:if="{{f}}" class="data-v-d5c0dd20" name="timePicker1" value="{{g}}" start="{{h}}" mode="time" bindchange="{{i}}"> + 选择配送时间 </picker><picker wx:else class="data-v-d5c0dd20" name="timePicker2" value="{{k}}" start="{{l}}" mode="time" bindchange="{{m}}">{{j}}</picker></view></view><view class="card data-v-d5c0dd20"><view class="title data-v-d5c0dd20"> 订单详情 </view><view class="order-product-content data-v-d5c0dd20"><view wx:for="{{n}}" wx:for-item="orderProduct" wx:key="f" class="order-product data-v-d5c0dd20"><text class="name data-v-d5c0dd20">{{orderProduct.a}}</text><text class="specification data-v-d5c0dd20">{{orderProduct.b}}</text><view class="data-v-d5c0dd20"><text class="specification data-v-d5c0dd20">数量：{{orderProduct.c}}</text><text class="specification data-v-d5c0dd20">单价：￥{{orderProduct.d}}</text><text class="price data-v-d5c0dd20">小计：￥{{orderProduct.e}}</text></view></view></view><view class="price-cal data-v-d5c0dd20"><view class="package-price data-v-d5c0dd20"><text class="data-v-d5c0dd20">打包费用：￥{{o}}</text></view><view class="delivery-price data-v-d5c0dd20"><text class="data-v-d5c0dd20">配送费用：￥{{p}}</text></view><view class="total-price data-v-d5c0dd20"><text class="data-v-d5c0dd20">总计：￥{{q}}</text></view></view></view><view class="card data-v-d5c0dd20"><view class="title data-v-d5c0dd20"> 订单备注 </view><view class="content data-v-d5c0dd20"><input class="data-v-d5c0dd20" type="text" placeholder="请输入订单备注" value="{{r}}" bindinput="{{s}}"/></view></view><view class="card data-v-d5c0dd20"><view class="title data-v-d5c0dd20"> 支付方式 </view><view class="content data-v-d5c0dd20"><text class="specification data-v-d5c0dd20">余额支付（暂未接入微信支付接口）</text></view></view><button class="primary data-v-d5c0dd20" bindtap="{{t}}">提交订单</button>